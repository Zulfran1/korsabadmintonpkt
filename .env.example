# ═══════════════════════════════════════════════════════════════════════════
# ENV VARIABLES — KORSA 2026 BULU TANGKIS
# Copy file ini jadi .env, lalu isi nilainya.
# Untuk Netlify: masukkan lewat Dashboard → Site settings → Environment variables
# ═══════════════════════════════════════════════════════════════════════════

# ── Admin ─────────────────────────────────────────────────────────────────
ADMIN_USERNAME=ganti-username-admin
ADMIN_PASSWORD_HASH=$2b$12$GANTI_DENGAN_HASH_BCRYPT

# ── Operator meja 1–4 ─────────────────────────────────────────────────────
OP1_USERNAME=ganti-username-operator-1
OP1_PASSWORD_HASH=$2b$12$GANTI_DENGAN_HASH_BCRYPT
OP1_MEJA=1

OP2_USERNAME=ganti-username-operator-2
OP2_PASSWORD_HASH=$2b$12$GANTI_DENGAN_HASH_BCRYPT
OP2_MEJA=2

OP3_USERNAME=ganti-username-operator-3
OP3_PASSWORD_HASH=$2b$12$GANTI_DENGAN_HASH_BCRYPT
OP3_MEJA=3

OP4_USERNAME=ganti-username-operator-4
OP4_PASSWORD_HASH=$2b$12$GANTI_DENGAN_HASH_BCRYPT
OP4_MEJA=4

# ── Session TTL (jam) ─────────────────────────────────────────────────────
SESSION_TTL_HOURS=12

# ── Rate limit login ──────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
